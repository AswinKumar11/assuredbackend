{
  "info": {
    "name": "AssuredGig \u2014 Ops",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run 'Login' first; it saves the tokens. 'Create ops user' saves the new user's id as {{opsUserId}} for the other requests."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/v1"
    },
    {
      "key": "adminEmail",
      "value": "aswinyadav123@gmail.com"
    },
    {
      "key": "adminPassword",
      "value": "assuredGig@123"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "opsUserId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ops/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ops",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const b = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', b.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', b.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ops/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ops",
                "auth",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const b = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', b.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', b.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ops/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ops",
                "auth",
                "logout"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Ops users (ADMIN)",
      "item": [
        {
          "name": "Create ops user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ops/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ops",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ops1@assuredgig.in\",\n  \"password\": \"change-me-12chars\",\n  \"role\": \"OPS\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "role: ADMIN | OPS | READ_ONLY (optional, defaults to OPS). Password 12-128 chars."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('opsUserId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Change role",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ops/users/{{opsUserId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ops",
                "users",
                "{{opsUserId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"READ_ONLY\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Disable user",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ops/users/{{opsUserId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ops",
                "users",
                "{{opsUserId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"disabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Enable user",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ops/users/{{opsUserId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ops",
                "users",
                "{{opsUserId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"disabled\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ops/users/{{opsUserId}}/password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ops",
                "users",
                "{{opsUserId}}",
                "password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"another-12-chars\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "healthz",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "healthz"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    }
  ]
}